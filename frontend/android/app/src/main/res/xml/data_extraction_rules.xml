<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 (API 31) and later: the same rule as backup_rules.xml for the cloud backup, where
     the 25 MB cap applies. A device-to-device transfer has no such cap, and a phone moved to a
     new one should arrive with its photos and videos. Device-specific watch bindings are
     excluded from both routes; the recorded measurements travel with training history. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="opengym-media/" />
        <exclude domain="sharedpref" path="wear-heart-journal.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="wear-heart-journal.xml" />
    </device-transfer>
</data-extraction-rules>
