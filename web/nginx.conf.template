# Static app and optional catalog media. Firebase is reached directly by the SDK.
server {
    listen ${NGINX_PORT};
    root /usr/share/nginx/html;
    index index.html;
    absolute_redirect off;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Content-Security-Policy "frame-ancestors 'none'" always;

    # Screens use hash routes; unknown extensionless paths return to the app root.
    location ${BASE_PATH}/ {
        rewrite ^\Q${BASE_PATH}\E/(.*)$ /$1 break;
        try_files $uri $uri/ @root;
    }
    location @root {
        return 302 ${BASE_PATH}/$is_args$args;
    }

    # Missing code is a 404, never a successful HTML shell response.
    location ~* \.(js|css|json|html|webmanifest)$ {
        rewrite ^\Q${BASE_PATH}\E/(.*)$ /$1 break;
        try_files $uri =404;
        add_header Cache-Control "no-cache, must-revalidate";
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
    }
    # Catalog media keeps its stable URLs and long cache lifetime.
    location ~* \.(png|jpg|jpeg|gif|ico|svg|woff|woff2|webp|avif|mp4|webm)$ {
        rewrite ^\Q${BASE_PATH}\E/(.*)$ /$1 break;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=2592000, immutable";
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
    }
    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_vary on;
    gzip_min_length 1024;
}
